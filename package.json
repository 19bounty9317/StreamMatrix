{
    "name": "streammatrix",
    "version": "1.4.11",
    "description": "StreamMatrix - Ein modernes Twitch-Dashboard für Streamer mit OBS-Integration",
    "main": "dist/main.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
        "dev:renderer": "vite",
        "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
        "dev:web": "vite --config vite.config.web.ts",
        "build": "tsc -p tsconfig.electron.json && vite build",
        "build:win": "npm run build && electron-builder --win --config",
        "build:mac": "npm run build && electron-builder --mac --config",
        "build:linux": "npm run build && electron-builder --linux --config",
        "build:web": "vite build --config vite.config.web.ts",
        "test:build": "npm run build && electron dist/main.js"
    },
    "keywords": [
        "twitch",
        "dashboard",
        "streamer",
        "electron"
    ],
    "author": "Michael Mader <StreamMatrix@web.de>",
    "license": "UNLICENSED",
    "private": true,
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@types/react-grid-layout": "^1.3.5",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.8",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "electron-updater": "^6.6.2",
        "firebase": "^12.6.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-grid-layout": "^1.4.4"
    },
    "build": {
        "appId": "com.streammatrix.app",
        "productName": "StreamMatrix",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "publish": {
            "provider": "github",
            "owner": "19bounty9317",
            "repo": "StreamMatrix"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "sign": null,
            "verifyUpdateCodeSignature": false,
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "publisherName": "StreamMatrix"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "StreamMatrix"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "assets/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "assets/icon.png"
        }
    }
}

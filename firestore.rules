rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Collection - Jeder kann lesen und schreiben
    // Dies ermöglicht anonyme Analytics von der App
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Analytics Collection - Jeder kann lesen und schreiben
    match /analytics/{userId} {
      allow read, write: if true;
    }
    
    // Alle anderen Collections - nur für authentifizierte Admins
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

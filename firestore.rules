rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Collection - Jeder kann lesen und schreiben
    // Dies ermöglicht anonyme Analytics von der App
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Analytics Collection - Jeder kann lesen und schreiben
    match /analytics/{userId} {
      allow read, write: if true;
    }
    
    // Streamer Directory - Jeder kann lesen, nur App kann schreiben
    match /streamers/{userId} {
      allow read: if true;
      allow write: if true; // App sendet Updates
      allow delete: if true; // Nutzer kann sich austragen
    }
    
    // Alle anderen Collections - nur für authentifizierte Admins
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
